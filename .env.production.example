# ===== MediPanda production values =====  (copy to .env or paste into your host's Environment tab)
# Never commit the real file.

# --- Core (REQUIRED on Render: defaults point to localhost / a weak dev secret) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medipanda?retryWrites=true&w=majority
JWT_SECRET=<random 48+ chars, e.g. output of: openssl rand -base64 48>
PUBLIC_BASE_URL=https://your-domain.com
# PORT is set automatically by Render/Railway; locally defaults to 8081
PORT=8081

# --- First admin (created once, password is NOT reset on restart) ---
DEMO_SEED_ENABLED=false
DEMO_SEED_RESET_PASSWORDS=false
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=<strong password>

# --- Email (Brevo) ---
BREVO_ENABLED=true
BREVO_API_KEY=<xkeysib-...>
BREVO_SENDER_EMAIL=<verified sender in Brevo>
BREVO_SENDER_NAME=MediPanda
OTP_DEV_CONSOLE=false

# --- SMS (default: Brevo SMS, reuses BREVO_API_KEY; needs SMS credits in Brevo) ---
SMS_ENABLED=true
SMS_PROVIDER=brevo
SMS_API_KEY=
SMS_SENDER_ID=MediPanda
# Alternative BD gateways: SMS_PROVIDER=alphasms or bulksmsbd, with SMS_API_KEY and SMS_SENDER_ID from that provider

# --- Push notifications (Firebase FCM) - optional ---
# Firebase console > Project settings > Service accounts > Generate new private key
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase.json
FCM_SERVICE_ACCOUNT_JSON=
# Firebase console > Project settings > General > Your apps (Web) : config as ONE line JSON
FIREBASE_WEB_CONFIG_JSON={"apiKey":"","authDomain":"","projectId":"","messagingSenderId":"","appId":""}
# Firebase console > Project settings > Cloud Messaging > Web Push certificates
FIREBASE_VAPID_KEY=

# --- Map routing (OpenStreetMap / OSRM) ---
OSRM_BASE_URL=https://router.project-osrm.org

# --- Uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=

# --- Payments (SSLCommerz). Use SSLCOMMERZ_SANDBOX=false only with live store credentials ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
